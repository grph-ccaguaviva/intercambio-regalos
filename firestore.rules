rules_version = '2';

// Reglas para Firestore (pegar en Firebase Console > Firestore > Reglas).
//
// esAdmin() usa el UID del usuario organizador (Firebase > Authentication > Users).
// Si recreas ese usuario, actualiza el UID aquí y vuelve a publicar las reglas.
//
// Privacidad:
// - personas/{clave}: el id ES el código secreto del link. Se puede leer un documento
//   si conoces su clave exacta, pero nadie puede listar la colección (salvo el organizador).
//   Ahí vive a quién le regala cada uno.
// - listas/{publicId}: nombre, grupo, lista de deseos y "tomado" (sin decir por quién).
// - firmas/{publicId}: solo escritura. Prueba que quien edita una lista conoce la clave del dueño.
service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      return request.auth != null && request.auth.uid == 'bVaBabMf97TnDVX2JuvDKvNZCV52';
    }
    function abierto() {
      return request.time < timestamp.date(2027, 1, 31);
    }
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }
    // Veces que ya eligieron esta lista (las antiguas solo tienen "tomado").
    function vecesAntes() {
      return resource.data.get('veces', resource.data.tomado == true ? 1 : 0);
    }
    function ruta(col, id) {
      return /databases/$(database)/documents/$(col)/$(id);
    }

    match /personas/{clave} {
      allow get: if true;
      allow list: if esAdmin();
      allow create, delete: if esAdmin();
      allow update: if esAdmin() || (abierto() && (
        soloCambia(['visto', 'actualizado'])
        || (soloCambia(['amigos', 'actualizado'])
            && request.resource.data.amigos is list
            && request.resource.data.amigos.size() > resource.data.amigos.size()
            && request.resource.data.amigos.size() <= resource.data.cupo
            && request.resource.data.amigos.hasAll(resource.data.amigos))
      ));
    }

    match /listas/{id} {
      allow read: if true;
      allow create, delete: if esAdmin();
      allow update: if esAdmin() || (abierto() && (
        // Alguien la elige como amigo secreto (quien recibe 1 regalo: solo una vez).
        (soloCambia(['tomado', 'actualizado'])
          && resource.data.get('recibe', 1) == 1
          && resource.data.tomado == false
          && request.resource.data.tomado == true)
        // Quien recibe varios regalos (recibe > 1): cada elección suma 1 hasta llenarse.
        || (soloCambia(['veces', 'tomado', 'actualizado'])
          && resource.data.get('recibe', 1) > 1
          && request.resource.data.veces == vecesAntes() + 1
          && request.resource.data.veces <= resource.data.get('recibe', 1)
          && request.resource.data.tomado == (request.resource.data.veces >= resource.data.get('recibe', 1)))
        // Su dueño edita sus regalos (la firma del mismo lote trae su clave),
        // solo hasta una semana antes del intercambio: 12/12/2026 00:00 de Lima (05:00 UTC).
        || (soloCambia(['regalos', 'actualizado'])
          && request.time < timestamp.date(2026, 12, 12) + duration.value(5, 'h')
          && request.resource.data.regalos is list
          && request.resource.data.regalos.size() <= 3
          && get(ruta('personas', getAfter(ruta('firmas', id)).data.clave)).data.publicId == id)
      ));
    }

    match /firmas/{id} {
      allow read: if false;
      allow write: if abierto() || esAdmin();
    }
  }
}
